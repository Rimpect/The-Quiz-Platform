# Демо-сборка (GitHub Pages). Активируется через `vite build --mode demo`.
# В CI эти же значения задаются переменными окружения (они приоритетнее).
VITE_DEMO=true
VITE_BASE=/The-Quiz-Platform/
# Ссылка на полную версию (VPS) — показывается в демо-баннере.
# Замените на реальный адрес сервера, когда он появится.
VITE_FULL_VERSION_URL=https://github.com/Rimpect/The-Quiz-Platform
